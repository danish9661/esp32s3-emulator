/target
**/__pycache__/
*.pyc
web/pkg/
web/hello.bin
web/firmware/*.bin
*.merged.bin
# sample firmware used for local browser testing (copy your own merged.bin)

# arduino-cli in-tree build output
tools/sketches/*/build/

# PGO raw training profiles (the merged profile IS committed)
tools/pgo/raw/

# reference materials
help/

# generated sketch artifacts (rebuilt by tools/build_ota.sh)
tools/sketches/*/*.ino.elf
tools/sketches/esp32s3_ota_update/ota_slot1_image.h

# Secure-boot dev key + intermediate signed app (rebuilt by tools/build_secure_boot.sh)
tools/sketches/esp32s3_secure_boot/secure_boot_signing_key.pem
tools/sketches/esp32s3_secure_boot/app_signed.bin

# Go gateway build output (rebuilt by tools/gateway/start-gateway.sh)
tools/gateway/openhw-gw
tools/gateway/openhw-gw.exe
